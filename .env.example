APP_NAME=Титло
APP_ENV=local
APP_KEY=base64:0Er7jr5B27PKZdWkOdD6MtYMxAwSNHTbtu157rObRwM=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=выа

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_BOT_TOKEN=TOKEN
TELEGRAM_BOT_USERNAME=TitloServiceBot

# Авария БД / outage page (см. docs/infrastructure/db-outage.md)
# OUTAGE_TELEGRAM_CHAT_IDS=123456789,987654321
# OUTAGE_FAIL_THRESHOLD=2
# OUTAGE_TELEGRAM_PROXY=
# api.telegram.org — один URL для local и сервера (socks5h, DNS через прокси):
TELEGRAM_PROXY=socks5h://USER:PASS@HOST:PORT

# Удаление неверифицированных пользователей (cron 02:15, php artisan schedule:run)
DELETE_UNVERIFIED_USERS=true
DELETE_UNVERIFIED_USERS_DAYS=30

# Регистрация: только .ru/.su и российские почтовики (titlo.ru + localhost при APP_ENV=local)
# SIGNUP_EMAIL_POLICY_ENABLED=true
# SIGNUP_EMAIL_POLICY_ENFORCE_LOCAL=true

# «Тургенев» (Ашманов) — API для сверки/скоринга (≈0,30 ₽/проверка); 100% = баллы как во внешнем отчёте
# TURGENEV_API_URL=https://turgenev.ashmanov.com/
# TURGENEV_API_KEY=
# ESENIN_TURGENEV_ENABLED=false
# TURGENEV_SCORE_BLEND_PERCENT=100

# LanguageTool (self-host): ./scripts/languagetool-docker.sh start
# LANGUAGETOOL_URL=http://127.0.0.1:8010
# ESENIN_LANGUAGETOOL_ENABLED=false

# OpenCorpora — морфология (по умолчанию включено, без ключа)
# ESENIN_OPENCORPORA_ENABLED=true

# Накопление кандидатов в словарь из сравнения с Тургеневым
# ESENIN_STYLE_LEARNING_ENABLED=true
# ESENIN_TURGENEV_REPORT_FETCH=true
# ESENIN_TURGENEV_REPORT_TIMEOUT=25

# Yandex Metrika OAuth (Management API) — https://oauth.yandex.ru/
YANDEX_METRIKA_CLIENT_ID=
YANDEX_METRIKA_CLIENT_SECRET=
# optional, default: {APP_URL}/yandex-metrika/callback
# YANDEX_METRIKA_REDIRECT_URI=

# Yandex Webmaster OAuth (API v4) — ОТДЕЛЬНОЕ приложение (не Метрика), свои лимиты.
# Scopes: webmaster:hostinfo webmaster:verify
# Redirect: {APP_URL}/yandex-webmaster/callback
YANDEX_WEBMASTER_CLIENT_ID=
YANDEX_WEBMASTER_CLIENT_SECRET=
# YANDEX_WEBMASTER_REDIRECT_URI=

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=

